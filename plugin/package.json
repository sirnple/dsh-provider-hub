{
  "name": "@sirnple/dsh-provider-hub",
  "version": "0.1.1",
  "description": "Model provider and account hub for DeepSeek Harness: multi-account API keys per provider with failover, a per-account usage/quota panel in the conversation header, and native Grok Build device-code OAuth.",
  "type": "module",
  "icon": "./assets/icon-180.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "grok.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/icon-180.png"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "author": "sirnple",
  "homepage": "https://github.com/sirnple/dsh-provider-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirnple/dsh-provider-hub.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/sirnple/dsh-provider-hub/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "provider",
    "accounts",
    "usage",
    "oauth",
    "grok"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  }
}
